---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import BackToPrev from "@components/BackToPrev.astro";

export async function getStaticPaths() {
  const breads = (await getCollection("breads"))
    .filter((bread) => !bread.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return breads.map((bread) => ({
    params: { slug: bread.slug },
    props: bread,
  }));
}
type Props = CollectionEntry<"breads">;

const bread = Astro.props;
const { Content } = await bread.render();
---

<PageLayout title={bread.data.title} description={bread.data.description}>
  <Container>
    <div class="animate">
      <BackToPrev href="/breads"> Back to breads </BackToPrev>
    </div>
    <div class="space-y-1 my-10">
      <div class="animate flex items-center gap-1.5">
        <div class="font-base text-sm">
          <FormattedDate date={bread.data.date} />
        </div>
        &bull;
        <div class="font-base text-sm">
          {readingTime(bread.body)}
        </div>
      </div>
      <div class="animate text-2xl font-semibold text-black dark:text-white">
        {bread.data.title}
      </div>
    </div>
    <article class="animate">
      <Content />
    </article>
  </Container>
</PageLayout>
